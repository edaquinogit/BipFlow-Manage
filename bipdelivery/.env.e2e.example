# Local Cypress/E2E throttle profile.
#
# Mirrors .github/workflows/ci.yml's frontend-e2e job env vars exactly --
# keep the two in sync if either changes. Running the backend without this
# (or an equivalent override) against a rapid sequence of local Cypress
# specs exhausts auth_ip/auth_login_identity within their real production
# windows (5-10/minute) almost immediately, since every login-based spec
# shares the same admin identity and IP; the resulting 429s/CAPTCHA gate
# have nothing to do with the code under test.
#
# Usage (from bipdelivery/, same as .env.example -> .env):
#   cp .env.e2e.example .env.e2e                          (bash)
#   Copy-Item .env.e2e.example .env.e2e                   (PowerShell)
#   DJANGO_ENV_FILE=.env.e2e python manage.py runserver 127.0.0.1:8000   (bash)
#   $env:DJANGO_ENV_FILE=".env.e2e"; python manage.py runserver 127.0.0.1:8000   (PowerShell)
#
# Never set DJANGO_ENV_FILE in production -- Render injects real env vars
# directly (see render.yaml), this file is never read there.
BIPFLOW_THROTTLE_AUTH_IP=1000/minute
BIPFLOW_THROTTLE_AUTH_LOGIN_IDENTITY=1000/minute
